# Public frontend configuration.
# These values are embedded in the public static build and must never be secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_FORMS_ENDPOINT=
NEXT_PUBLIC_DONATION_ENDPOINT=

# Never add Supabase secret keys, M-Pesa credentials, callback tokens,
# Resend API keys, PayPal secrets, or other private credentials to NEXT_PUBLIC_*.
